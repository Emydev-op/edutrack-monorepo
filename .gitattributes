# Normalise line endings so Windows and macOS checkouts produce the same diffs.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated files: collapsed in PR diffs.
package-lock.json linguist-generated=true -diff
**/CHANGELOG.md linguist-generated=true
