# The API is reached same-site under /api (the dev server proxies it to API_PROXY_TARGET), so the
# HttpOnly refresh cookie is first-party. Only change this for a deployed API on another path.
VITE_API_URL=/api
# Where the dev server sends /api requests.
API_PROXY_TARGET=http://localhost:8000
# false (the default): use the real backend; every back-office screen is live. true: serve the API
# from the in-browser mock instead (the design's seed data, no backend needed).
VITE_USE_MOCKS=false
