# The API is reached same-site under /api (the dev server proxies it to API_PROXY_TARGET), so the
# HttpOnly refresh cookie is first-party. Only change this for a deployed API on another path.
VITE_API_URL=/api
# Where the dev server sends /api requests.
API_PROXY_TARGET=http://localhost:3000
# true: serve the API from the in-browser mock (seed data from the design). false: use the real
# backend. Schools, plans, subscriptions and the dashboard are live; users, roles, audit, settings
# and support are still mock-only until their endpoints land.
VITE_USE_MOCKS=true
