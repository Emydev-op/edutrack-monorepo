# The API, relative to the portal: the dev server (and the local router) forward /api to the
# backend. Point the dev server elsewhere with API_PROXY_TARGET (default http://localhost:8000).
# Open the portal on the school's address (http://greenfield.localhost:5174/parent, or
# http://greenfield.localhost/parent through the local router) so the backend knows the school.
VITE_API_URL=/api
# Shown on the sign-in pages until the API names the school (GET /v1/public/school).
VITE_SCHOOL_NAME=Greenfield Academy
