NODE_ENV=development
PORT=3000
# Comma-separated list of portal origins allowed to call the API.
CORS_ORIGINS=http://localhost:5170,http://localhost:5171,http://localhost:5172,http://localhost:5173,http://localhost:5174

# PostgreSQL (infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://edutrack:edutrack@localhost:5432/edutrack?schema=public

# Redis — cache, BullMQ queues, distributed locks
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (RustFS locally; AWS S3 / R2 / Spaces in deployed envs)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=edutrack-local
S3_ACCESS_KEY_ID=edutrack
S3_SECRET_ACCESS_KEY=edutrack-secret
# Path-style URLs are required by RustFS/MinIO; set to false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Create the bucket on boot if missing. Local development only.
S3_CREATE_BUCKET=true
