NODE_ENV=development
PORT=3000
# Comma-separated list of portal origins allowed to call the API.
CORS_ORIGINS=http://localhost:5170,http://localhost:5171,http://localhost:5172,http://localhost:5173,http://localhost:5174

# PostgreSQL (infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://edutrack:edutrack@localhost:5432/edutrack?schema=public

# Redis — cache, BullMQ queues, distributed locks
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (RustFS locally; AWS S3 / R2 / Spaces in deployed envs)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=edutrack-local
S3_ACCESS_KEY_ID=edutrack
S3_SECRET_ACCESS_KEY=edutrack-secret
# Path-style URLs are required by RustFS/MinIO; set to false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Create the bucket on boot if missing. Local development only.
S3_CREATE_BUCKET=true

# Behind a proxy/load balancer: which hops may set X-Forwarded-For (rate limits and session IPs
# depend on it). `loopback` locally; the proxy's CIDR or a hop count when deployed.
TRUST_PROXY=loopback
# JSON log lines. Defaults to true in production.
# LOG_JSON=false

# Tenancy: school portals live on <slug>.APP_BASE_DOMAIN (greenfield.edutrack.ng). Locally
# `localhost`, so http://greenfield.localhost:5172 works; the x-tenant-id / x-school-slug header is
# also accepted outside production.
APP_BASE_DOMAIN=localhost

# Auth. Production refuses to boot with the development JWT secret: generate one with
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-in-every-deployed-env
JWT_ACCESS_TTL_SECONDS=900
# "Keep me signed in" lifetime (days); without it, a browser-session cookie and this many hours.
REFRESH_TTL_REMEMBER_DAYS=30
REFRESH_TTL_SESSION_HOURS=12
REFRESH_REUSE_GRACE_SECONDS=10
# Secure cookies need HTTPS. Defaults to true except in development and test.
COOKIE_SECURE=false
# Leave empty for host-only cookies (recommended).
COOKIE_DOMAIN=
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7
# Lockout for platform staff (schools set their own in Settings → Security).
PLATFORM_LOCKOUT_ATTEMPTS=5
PLATFORM_LOCKOUT_MINUTES=15

# Links in emails and SMS. `{slug}` is the school's subdomain.
PLATFORM_PORTAL_URL=http://localhost:5170
SCHOOL_ADMIN_PORTAL_URL=http://localhost:5171
TEACHER_PORTAL_URL_TEMPLATE=http://localhost:5172
# Deployed: TEACHER_PORTAL_URL_TEMPLATE=https://{slug}.edutrack.ng/teacher

# Mail: Mailpit locally (SMTP :1025, inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=EduTrack <no-reply@edutrack.ng>
# MAIL_REPLY_TO=support@edutrack.ng

# SMS: `log` writes messages to the API log. Termii comes later.
SMS_DRIVER=log
SMS_SENDER_ID=EduTrack
