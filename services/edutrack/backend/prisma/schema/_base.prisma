// EduTrack database schema (multi-file). See docs/backend/data-model.md for the design.
//
// Conventions
// - Models PascalCase singular, fields camelCase; tables and columns snake_case via @@map/@map.
// - IDs: UUIDv7 generated by Prisma. Human-facing numbers come from NumberSequence.
// - Every school-owned row carries school_id. Relations between school-owned rows are composite
//   foreign keys (school_id, x_id) -> (school_id, id) so a row can never point into another tenant.
// - Money is integer kobo (BigInt). Timestamps are timestamptz(3); calendar days are date.
// - Columns named *ById that hold "who clicked" are plain user ids without a foreign key: users are
//   never hard-deleted, and the audit trail keeps the full story.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}
