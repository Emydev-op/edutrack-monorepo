// EduTrack database schema.
// Models are added once the backend architecture is finalised.
// Docs: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}
