# The API, relative to the portal: the dev server (and the local router) forward /api to the
# backend. Point the dev server elsewhere with API_PROXY_TARGET (default http://localhost:8000).
VITE_API_URL=/api
# "true" serves every API call from the in-browser mock (the default in development). "false"
# calls the real API for the sections already built (src/api/real-routes.ts) and the mock for the
# rest; open the portal through the local router (http://greenfield.localhost/teacher) so the
# backend knows the school.
VITE_USE_MOCKS=
# VITE_SCHOOL_NAME=Your school
