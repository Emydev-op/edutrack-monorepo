{
  "name": "@edutrack/teacher-portal",
  "version": "0.1.0",
  "private": true,
  "description": "EduTrack Teacher Portal — Teachers managing classes, attendance and grades",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache"
  },
  "dependencies": {
    "@edutrack/shared": "*",
    "@edutrack/ui": "*",
    "@edutrack/web-core": "*",
    "@tanstack/vue-query": "^5.105.3",
    "@vee-validate/yup": "^4.15.1",
    "pinia": "^4.1.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.93.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
